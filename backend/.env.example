# انسخ هذا الملف إلى .env وعدّل القيم بما يناسب السيرفر المحلي للمنشأة

# قاعدة البيانات - إما حقول منفصلة (محليًا عبر Docker)...
DB_HOST=db
DB_PORT=5432
DB_NAME=hospital_db
DB_USER=hospital_admin
DB_PASSWORD=change_this_password

# ...أو رابط اتصال واحد جاهز (تعطيه بعض منصات الاستضافة مثل Render كـ "Internal Database URL")
# عند تعيينه، يُتجاهَل ما سبق تلقائيًا. فعّل DB_SSL=true إن طلبت المنصة اتصالًا مشفّرًا
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true

# مفتاح تشفير التوكن (JWT) - غيّره لقيمة عشوائية طويلة قبل النشر الفعلي
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=12h

# منفذ الخادم
PORT=4000

# بيئة التشغيل
NODE_ENV=production

# النسخ الاحتياطي التلقائي لقاعدة البيانات
# صيغة cron قياسية - الافتراضي: كل يوم الساعة 2:00 صباحًا
BACKUP_CRON=0 2 * * *
# عدد النسخ الاحتياطية المُحتفَظ بها قبل حذف الأقدم تلقائيًا
BACKUP_RETENTION_COUNT=14
